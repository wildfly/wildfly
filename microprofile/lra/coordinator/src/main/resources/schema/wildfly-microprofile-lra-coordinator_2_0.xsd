<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:wildfly:microprofile-lra-coordinator:2.0"
           xmlns="urn:wildfly:microprofile-lra-coordinator:2.0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="2.0">

  <!-- The lra-coordinator subsystem root element -->
  <xs:element name="subsystem" type="lraCoordinatorSubsystemType"/>

  <xs:complexType name="lraCoordinatorSubsystemType">
    <xs:annotation>
      <xs:documentation>
        <![CDATA[
                The configuration of the LRA Coordinator subsystem.
                The "server" attribute defines the Undertow subsystem 'server' resource the coordinator is started at.
                The "host" attribute defines the Undertow subsystem 'host' resource the coordinator is started at.
                Both attributes reference Undertow subsystem capabilities, so they must resolve to existing
                'server' and 'host' resources. They do not define default values and do not allow expressions.
            ]]>
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="server" type="xs:string" use="optional"/>
    <xs:attribute name="host" type="xs:string" use="optional"/>
  </xs:complexType>
</xs:schema>
