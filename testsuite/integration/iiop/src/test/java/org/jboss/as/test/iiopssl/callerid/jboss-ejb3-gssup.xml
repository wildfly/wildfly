<jboss:ejb-jar xmlns:jboss="http://www.jboss.com/xml/ns/javaee"
               xmlns="http://java.sun.com/xml/ns/javaee"
               xmlns:iiop="urn:iiop"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.jboss.com/xml/ns/javaee http://www.jboss.org/j2ee/schema/jboss-ejb3-2_0.xsd http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/ejb-jar_3_1.xsd"
               version="3.1"
               impl-version="2.0">
    <assembly-descriptor>
        <method-permission>
            <unchecked/>
            <method>
                <ejb-name>CallerPropGssupAndTlsBean</ejb-name>
                <method-name>*</method-name>
            </method>
        </method-permission>
        <iiop:iiop>
            <ejb-name>*</ejb-name>
            <iiop:ior-security-config>
                <iiop:transport-config
                    iiop:integrity="required"
                    iiop:confidentiality="required"
                    iiop:establish-trust-in-target="supported"
                    iiop:establish-trust-in-client="required"
                />
                <iiop:as-context
                    iiop:auth-method="username_password"
                    iiop:realm="default"
                    iiop:required="true"
                />
                <iiop:sas-context
                    iiop:caller-propagation="supported"
                />
            </iiop:ior-security-config>
        </iiop:iiop>
    </assembly-descriptor>
</jboss:ejb-jar>
