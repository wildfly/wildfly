<ejb-jar xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/ejb-jar_3_1.xsd"
         version="3.1">
    <enterprise-beans>
        <session>
            <ejb-name>ClientEjb</ejb-name>
            <session-type>Stateless</session-type>
            <ejb-ref>
                <ejb-ref-name>gssupHome</ejb-ref-name>
                <injection-target>
                    <injection-target-class>org.jboss.as.test.iiop.callerid.ClientEjb</injection-target-class>
                    <injection-target-name>gssupHome</injection-target-name>
                </injection-target>
                <lookup-name>corbaname:iiop:${node1}:3628#CallerPropBean</lookup-name>
            </ejb-ref>
            <ejb-ref>
                <ejb-ref-name>noGssupHome</ejb-ref-name>
                <injection-target>
                    <injection-target-class>org.jboss.as.test.iiop.callerid.ClientEjb</injection-target-class>
                    <injection-target-name>noGssupHome</injection-target-name>
                </injection-target>
                <lookup-name>corbaname:iiop:${node1}:3628#CallerPropNoGssupBean</lookup-name>
            </ejb-ref>
            <ejb-ref>
                <ejb-ref-name>defaultDomainHome</ejb-ref-name>
                <injection-target>
                    <injection-target-class>org.jboss.as.test.iiop.callerid.ClientEjb</injection-target-class>
                    <injection-target-name>defaultDomainHome</injection-target-name>
                </injection-target>
                <lookup-name>corbaname:iiop:${node1}:3628#CallerPropDefaultDomainBean</lookup-name>
            </ejb-ref>
        </session>
    </enterprise-beans>
</ejb-jar>
