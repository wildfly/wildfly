<module xmlns="urn:jboss:module:1.9" name="org.wildfly.extension.vertx">
    <properties>
        <property name="jboss.api" value="private"/>
        <property name="jboss.stability" value="preview"/>
    </properties>

    <resources>
        <artifact name="${org.wildfly:wildfly-vertx-subsystem}"/>
    </resources>

    <dependencies>
        <module name="java.xml"/>
        <module name="jakarta.enterprise.api"/>

        <module name="io.vertx.core" />
        <module name="io.netty.netty-common" />
        <module name="io.smallrye.common.annotation" />
        <module name="io.smallrye.reactive.mutiny.vertx-core" />

        <module name="org.jboss.as.ee"/>
        <module name="org.jboss.as.controller"/>
        <module name="org.jboss.as.server"/>
        <module name="org.jboss.as.version"/>
        <module name="org.jboss.as.weld.common"/>
        <module name="org.jboss.jandex"/>
        <module name="org.jboss.logging"/>
        <module name="org.jboss.modules"/>
        <module name="org.jboss.staxmapper"/>
        <module name="org.jboss.vfs"/>
        <module name="org.wildfly.security.manager" />
        <module name="org.wildfly.subsystem"/>
    </dependencies>
</module>
